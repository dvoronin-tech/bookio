{
    "name": "bookio",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "book": "pnpm --filter @bookio/booking",
        "front": "pnpm --filter @bookio/frontend",
        "back": "pnpm --filter @bookio/backend",
        "db": "pnpm --filter @bookio/db",
        "typecheck": "pnpm --filter @bookio/frontend exec paraglide-js compile --project ./project.inlang && tsc -b --pretty",
