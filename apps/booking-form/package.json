{
    "name": "@bookio/booking-form",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "vite dev --port 3000",
        "generate-routes": "tsr generate",
        "build": "pnpm --filter @bookio/ui --filter @bookio/booking-form-ui exec paraglide-js compile --project ./project.inlang && paraglide-js compile --project ./project.inlang && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "lint": "eslint",
        "format": "prettier --write . && eslint --fix",
        "check": "prettier --check ."
    },
    "dependencies": {
        "@bookio/backend": "workspace:*",
        "@bookio/booking-form-ui": "workspace:*",
        "@bookio/ui": "workspace:*",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-devtools": "0.10.14",
        "@tanstack/react-query": "5.105.3",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-router-devtools": "1.167.2",
        "@tanstack/react-router-ssr-query": "1.167.3",
        "@tanstack/react-start": "1.169.4",
        "@tanstack/router-plugin": "1.168.48",
        "clsx": "^2.1.1",
        "hono": "^4.12.27",
        "motion": "^12.42.2",
        "nitro": "npm:nitro-nightly@latest",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.81.0",
        "tailwindcss": "^4.1.18",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@inlang/paraglide-js": "^3.2.2",
        "@tailwindcss/typography": "^0.5.16",
        "@tanstack/devtools-vite": "0.8.6",
        "@tanstack/eslint-config": "0.4.0",
        "@tanstack/router-cli": "1.167.46",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^22.10.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^9.20.0",
        "jsdom": "^28.1.0",
        "prettier": "^3.8.1",
        "sass-embedded": "^1.100.0",
        "typescript": "^6.0.2",
        "vite": "^8.0.0",
        "vite-imagetools": "^10.0.1",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^4.1.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "lightningcss"
        ]
    }
}
